<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="spatialePU" transaction-type="RESOURCE_LOCAL">
        <class>spatiale.RapportMission</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:./data/astro"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/> <!-- update ici crée la table au premier lancement et la met à jour ensuite, sinon si on veut pas garder les rapports entre les exécutions on peut mettre create -->
        </properties>
    </persistence-unit>
</persistence>